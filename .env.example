# ══════════════════════════════════════════════════════════════════════
#  AI Fallback Agent — Environment Variables
#  Copy this file:  cp .env.example .env   then fill in your values
# ══════════════════════════════════════════════════════════════════════


# ── LAYER 1: Your Custom Chatbot API ──────────────────────────────────
#
#  HOW TO MAP YOUR CURL COMMAND:
#  ─────────────────────────────
#  Example curl:
#    curl -X POST https://mybot.example.com/api/chat \
#      -H "Authorization: Bearer my-secret-token" \
#      -d '{"query": "hello", "user": "abc"}'
#
#  Maps to:
#    CUSTOM_BOT_URL      = https://mybot.example.com/api/chat
#    CUSTOM_BOT_API_KEY  = my-secret-token
#    CUSTOM_BOT_PAYLOAD_TEMPLATE = {"query": "{message}", "user": "{session_id}"}
#
#  Placeholders: {message} = user question, {session_id} = session id

CUSTOM_BOT_URL=https://your-chatbot-api.com/endpoint
CUSTOM_BOT_API_KEY=your_chatbot_bearer_token_here
CUSTOM_BOT_HEADERS={}
CUSTOM_BOT_PAYLOAD_TEMPLATE={"message": "{message}", "session_id": "{session_id}"}


# ── LAYER 2: SearXNG Self-Hosted Search ──────────────────────────────
#
#  Your SearXNG instance — already live, no API key needed.
#  Mirrors this curl exactly:
#    curl -X POST "http://140.238.166.109:8081/search" \
#      -d "q=<query>&format=json&categories=general,news&language=en"
#
#  SEARXNG_CATEGORIES options: general, news, science, it, social media, etc.

SEARXNG_URL=http://140.238.166.109:8081/search
SEARXNG_LANGUAGE=en
SEARXNG_CATEGORIES=general,news


# ── LAYER 3: Gemini 2.0 Flash ────────────────────────────────────────
#
#  Get FREE key at:  https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here


# ── Optional settings ─────────────────────────────────────────────────
REQUEST_TIMEOUT=12
